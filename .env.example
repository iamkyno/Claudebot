# Copy to .env. scripts/mac/setup_wine.sh fills in MT5_BRIDGE_KEY for you.

# Shared secret between the bot and the MT5 bridge running in Wine
MT5_BRIDGE_KEY=

# Leave the MT5 lines blank to attach to the MT5 terminal you're already logged into.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows-style path inside Wine, only if MT5 isn't found automatically, e.g.
# C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# iMessage alerts: your phone number (+27...) or Apple ID email
IMESSAGE_TO=
