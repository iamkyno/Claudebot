# Copy to .env (never commit it). From Exness Personal Area > Key Management.
EXN_API_KEY=
# Private signing key: the 128 hex characters Exness shows once, or point to a PEM file instead
EXN_PRIVATE_KEY=
EXN_PRIVATE_KEY_FILE=
# The trading account the key is for
EXN_ACCOUNT_ID=
# Gateway host from the DNS widget in Key Management, e.g. https://....exness.com
EXN_DISCOVERY_BASE_URL=

# iMessage alerts: your phone number (+27...) or Apple ID email
IMESSAGE_TO=
