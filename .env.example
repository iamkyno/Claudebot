# Copy to .env and fill in. EVERYTHING here is optional.
# With no values set, the bot runs in paper mode on public market data.

# --- Binance (only needed for LIVE trading) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Database (defaults shown; only override if your setup differs) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claudebot
DB_USER=postgres
DB_PASSWORD=postgres

# --- Telegram alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
